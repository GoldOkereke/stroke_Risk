APP_NAME=Stroke Shield
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Development-only default. Override this in production.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Paths can be overridden with absolute paths if needed.
DATASETS_ROOT=datasets
UPLOAD_DIR=storage/uploads
MODEL_DIR=storage/models

# Known optional datasets
AFDB_DIR=cardiac/mitbih_af/files/afdb
AFDB_RECORDS_FILE=cardiac/mitbih_af/RECORDS
PARKINSONS_CSV=speech/uci_parkinsons/parkinsons.csv
